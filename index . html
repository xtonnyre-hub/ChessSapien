<style>
:root{--bg:#fafafa;--card:#fff;--ink:#171717;--mut:#666;--line:#ebebeb;--ok:#297a3a;--r:6px;--ring:0 0 0 1px rgba(0,0,0,.08),0 0 0 2px #fafafa;--l:#f0f0f0;--d:#d4d4d4}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 14px/1.55 'Geist',system-ui,-apple-system,'Segoe UI',sans-serif;letter-spacing:-.02em}
h1,h2,h3{font-weight:450;letter-spacing:-.06em;margin:0 0 8px}
h2{font-size:22px}h3{font-size:15px}
.mono,th,label,.badge,.tab,.pr,.ok{font-family:'Geist Mono',ui-monospace,Menlo,monospace;font-size:11px;text-transform:uppercase;letter-spacing:.071em}
.wrap{max-width:1100px;margin:0 auto;padding:16px}
.top{display:flex;flex-wrap:wrap;align-items:center;gap:16px;justify-content:space-between;padding:12px 0 20px}
.mark{font-size:18px;letter-spacing:-.06em;font-weight:500}.mark span{color:#000}
nav{display:flex;gap:4px;flex-wrap:wrap}
.tab{background:none;border:0;border-radius:var(--r);padding:8px 12px;color:var(--mut);cursor:pointer}
.tab[aria-selected=true]{background:var(--card);color:var(--ink);box-shadow:var(--ring)}
.card{background:var(--card);border-radius:var(--r);box-shadow:var(--ring);padding:16px}
.grid{display:grid;grid-template-columns:minmax(0,560px) minmax(0,1fr);gap:16px;align-items:start}
.col{display:grid;gap:16px}
@media(max-width:860px){.grid{grid-template-columns:1fr}}
.btn{background:var(--ink);color:#fff;border:1px solid var(--ink);border-radius:var(--r);padding:8px 12px;font:inherit;cursor:pointer}
.btn.g{background:transparent;color:var(--ink);border-color:var(--line)}
.btn:hover{opacity:.85}
:is(button,input,select,textarea):focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
input,select,textarea{font:inherit;border:1px solid var(--line);border-radius:var(--r);padding:8px;background:#fff;color:var(--ink);width:100%}
#status{margin-bottom:10px;color:var(--mut)}
.board{display:grid;grid-template-columns:repeat(8,1fr);aspect-ratio:1;width:100%;border-radius:var(--r);overflow:hidden;box-shadow:var(--ring)}
.sq{display:flex;align-items:center;justify-content:center;border:0;padding:0;margin:0;cursor:pointer;position:relative;font-size:clamp(24px,6.4vw,50px);line-height:1}
.sq.l{background:var(--l)}.sq.d{background:var(--d)}
.sq.last{box-shadow:inset 0 0 0 100px rgba(23,23,23,.08)}
.sq.sel{box-shadow:inset 0 0 0 3px var(--ink)}
.sq.mv::after,.sq.cp::after{content:'';position:absolute;border-radius:50%;pointer-events:none}
.sq.mv::after{width:22%;height:22%;background:rgba(23,23,23,.4)}
.sq.cp::after{width:84%;height:84%;border:3px solid rgba(23,23,23,.4)}
.w{color:#fff;text-shadow:0 0 1px #000,0 0 1px #000,0 0 2px #000,0 1px 1px #000}.b{color:var(--ink)}
.cli{height:300px;overflow:auto;font:12px/1.7 'Geist Mono',ui-monospace,monospace;letter-spacing:0}
.pr{color:var(--ink);text-transform:none;font-size:12px}.ok{color:var(--ok);text-transform:none;font-size:12px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.stats b{display:block;font-size:20px;font-weight:450;letter-spacing:-.06em}
.badge{display:inline-block;border:1px solid var(--ink);border-radius:var(--r);padding:1px 6px;font-size:10px}
table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line)}th{color:var(--mut);font-weight:400}
.post p{margin:6px 0 0;overflow-wrap:anywhere}.view[hidden]{display:none}
.arow{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--line)}
dialog{border:0;border-radius:var(--r);box-shadow:var(--ring),0 8px 40px rgba(0,0,0,.12);padding:20px;width:min(720px,94vw)}
dialog::backdrop{background:rgba(0,0,0,.3)}
.rrow{display:grid;grid-template-columns:90px 1fr 1fr;gap:8px;align-items:center;margin-bottom:8px}
@media(max-width:600px){.rrow{grid-template-columns:1fr}}
.note{color:var(--mut);font-size:13px;margin:6px 0 0}
.brand{display:flex;align-items:center;gap:12px}.sub{color:var(--mut);font-size:10px}
.sq span{display:flex;align-items:center;justify-content:center;width:100%;height:100%}
.sq.top{z-index:3}.slide{animation:slide .26s cubic-bezier(.2,.8,.25,1)}
@keyframes slide{from{transform:translate(var(--dx),var(--dy))}}
.sq.boom::before{content:'';position:absolute;inset:10%;border-radius:50%;border:3px solid #e3c58e;animation:boom .55s ease-out forwards;pointer-events:none;z-index:4}
@keyframes boom{to{transform:scale(2.2);opacity:0}}
.sq.chk{animation:chk 1.1s ease-in-out infinite}
@keyframes chk{50%{box-shadow:inset 0 0 0 4px #e3c58e,inset 0 0 22px #e3c58e}}
.w{transition:transform .15s}.sq:hover .w,.sq:hover .b{transform:translateY(-2px)}
.star{position:fixed;color:#e3c58e;pointer-events:none;z-index:60;text-shadow:0 0 8px #e3c58e;animation:fly 1.6s cubic-bezier(.1,.7,.3,1) forwards}
@keyframes fly{from{transform:translate(-50%,-50%) scale(.3)}70%{opacity:1}to{transform:translate(calc(-50% + var(--x)),calc(-50% + var(--y))) scale(1) rotate(180deg);opacity:0}}
.toast{position:fixed;left:50%;top:22%;transform:translateX(-50%);background:#183630;color:#e3c58e;border-radius:var(--r);padding:8px 14px;font:500 13px 'Geist Mono',monospace;z-index:60;animation:up 1.4s ease-out forwards}
@keyframes up{from{opacity:0;margin-top:20px}15%{opacity:1}to{opacity:0;margin-top:-30px}}
.foot{margin-top:32px;background:#183630;color:#e4dccb;text-align:center;padding:28px 16px}
.foot img{max-width:70%;height:auto}.foot p{color:#e3c58e;margin:10px 0 0}
#splash{position:fixed;inset:0;background:#183630;display:grid;place-items:center;z-index:100;transition:opacity .6s}
#splash.out{opacity:0;pointer-events:none}
.sp{text-align:center;position:relative;padding:20px}
.sp>img{max-width:55vw;height:auto;animation:rise 1.4s cubic-bezier(.2,.8,.2,1) both}
@keyframes rise{from{opacity:0;transform:scale(.8) rotate(-10deg)}}
.spark{position:absolute;color:#e3c58e;font-size:26px;animation:tw 2s ease-in-out infinite}
.s1{top:28%;left:46%}.s2{top:55%;left:70%;animation-delay:.9s;font-size:18px}
@keyframes tw{0%,100%{opacity:.15;transform:scale(.6)}50%{opacity:1;transform:scale(1.2)}}
.lema{font:italic 20px Georgia,'Times New Roman',serif;color:#e3c58e;letter-spacing:.02em;opacity:0;animation:fade 1s 1.1s forwards}
.btn.gold{background:#e3c58e;color:#183630;border-color:#e3c58e;opacity:0;animation:fade .8s 1.8s forwards}
@keyframes fade{to{opacity:1}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.lema,.btn.gold{opacity:1}}
