  </form>
</dialog>

<script>
/* MindChess · engine.js — reglas oficiales: enroque, al paso, coronación, jaque mate, ahogado y repetición. */
const D = [[1,0],[-1,0],[0,1],[0,-1]], DG = [[1,1],[1,-1],[-1,1],[-1,-1]];
const N = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]];
const VAL = { P: 1, N: 3, B: 3, R: 5, Q: 9, K: 0 };
const RIGHTS = { 60: ['wK','wQ'], 56: ['wQ'], 63: ['wK'], 4: ['bK','bQ'], 0: ['bQ'], 7: ['bK'] };

function init() {
  const b = Array(64).fill(null), bk = 'RNBQKBNR';
  for (let i = 0; i < 8; i++) { b[i] = 'b' + bk[i]; b[8 + i] = 'bP'; b[48 + i] = 'wP'; b[56 + i] = 'w' + bk[i]; }
  return { b, turn: 'w', ca: { wK: 1, wQ: 1, bK: 1, bQ: 1 }, ep: -1, half: 0 };
}

function att(b, sq, by) {
  const r = sq >> 3, c = sq & 7, pd = by === 'w' ? 1 : -1;
  const at = (rr, cc, p) => rr >= 0 && rr < 8 && cc >= 0 && cc < 8 && b[rr * 8 + cc] === by + p;
  if (at(r + pd, c - 1, 'P') || at(r + pd, c + 1, 'P')) return true;
  for (const [dr, dc] of N) if (at(r + dr, c + dc, 'N')) return true;
  for (const [dr, dc] of [...D, ...DG]) if (at(r + dr, c + dc, 'K')) return true;
  for (const [dirs, t] of [[D, 'R'], [DG, 'B']]) for (const [dr, dc] of dirs) {
    let rr = r + dr, cc = c + dc;
    while (rr >= 0 && rr < 8 && cc >= 0 && cc < 8) {
      const p = b[rr * 8 + cc];
      if (p) { if (p[0] === by && (p[1] === t || p[1] === 'Q')) return true; break; }
      rr += dr; cc += dc;
    }
  }
  return false;
}

function pseudo(s) {
  const { b, turn: col, ca, ep } = s, o = [], opp = col === 'w' ? 'b' : 'w';
  for (let i = 0; i < 64; i++) {
    const p = b[i]; if (!p || p[0] !== col) continue;
    const r = i >> 3, c = i & 7, t = p[1];
    if (t === 'P') {
      const d = col === 'w' ? -1 : 1, st = col === 'w' ? 6 : 1, pr = col === 'w' ? 0 : 7, f1 = i + d * 8;
      const add = (to, x = {}) => (to >> 3 === pr) ? ['Q','R','B','N'].forEach(q => o.push({ f: i, t: to, pr: q, ...x })) : o.push({ f: i, t: to, ...x });
      if (!b[f1]) { add(f1); if (r === st && !b[f1 + d * 8]) o.push({ f: i, t: f1 + d * 8 }); }
      for (const dc of [-1, 1]) {
        const cc = c + dc; if (cc < 0 || cc > 7) continue;
        const to = f1 + dc;
        if (b[to] && b[to][0] === opp) add(to); else if (to === ep) add(to, { ep: 1 });
      }
    } else if (t === 'N' || t === 'K') {
      for (const [dr, dc] of (t === 'N' ? N : [...D, ...DG])) {
        const rr = r + dr, cc = c + dc; if (rr < 0 || rr > 7 || cc < 0 || cc > 7) continue;
        const to = rr * 8 + cc; if (!b[to] || b[to][0] === opp) o.push({ f: i, t: to });
      }
      const base = col === 'w' ? 56 : 0;
      if (t === 'K' && i === base + 4 && !att(b, i, opp)) {
        if (ca[col + 'K'] && !b[base + 5] && !b[base + 6] && b[base + 7] === col + 'R' && !att(b, base + 5, opp) && !att(b, base + 6, opp)) o.push({ f: i, t: base + 6, cs: 'K' });
        if (ca[col + 'Q'] && !b[base + 1] && !b[base + 2] && !b[base + 3] && b[base] === col + 'R' && !att(b, base + 3, opp) && !att(b, base + 2, opp)) o.push({ f: i, t: base + 2, cs: 'Q' });
      }
    } else {
      for (const [dr, dc] of (t === 'R' ? D : t === 'B' ? DG : [...D, ...DG])) {
        let rr = r + dr, cc = c + dc;
        while (rr >= 0 && rr < 8 && cc >= 0 && cc < 8) {
          const to = rr * 8 + cc;
          if (!b[to]) o.push({ f: i, t: to }); else { if (b[to][0] === opp) o.push({ f: i, t: to }); break; }
          rr += dr; cc += dc;
        }
      }
    }
  }
  return o;
}

function ap(s, m) {
  const b = s.b.slice(), p = b[m.f], col = p[0], opp = col === 'w' ? 'b' : 'w';
  const cap = m.ep ? opp + 'P' : b[m.t];
  b[m.t] = m.pr ? col + m.pr : p; b[m.f] = null;
  if (m.ep) b[m.t + (col === 'w' ? 8 : -8)] = null;
  if (m.cs) { const row = col === 'w' ? 56 : 0; if (m.cs === 'K') { b[row + 5] = b[row + 7]; b[row + 7] = null; } else { b[row + 3] = b[row]; b[row] = null; } }
  const ca = { ...s.ca };
  [m.f, m.t].forEach(q => (RIGHTS[q] || []).forEach(k => ca[k] = 0));
  const dbl = p[1] === 'P' && Math.abs(m.t - m.f) === 16;
  return { b, turn: opp, ca, ep: dbl ? (m.f + m.t) / 2 : -1, half: (p[1] === 'P' || cap) ? 0 : s.half + 1, cap };
}

const inChk = s => att(s.b, s.b.indexOf(s.turn + 'K'), s.turn === 'w' ? 'b' : 'w');
function legal(s) {
  const col = s.turn, opp = col === 'w' ? 'b' : 'w';
  return pseudo(s).filter(m => { const n = ap(s, m); return !att(n.b, n.b.indexOf(col + 'K'), opp); });
}
const key = s => s.b.join() + s.turn + Object.values(s.ca).join('') + s.ep;
const sqName = i => 'abcdefgh'[i & 7] + (8 - (i >> 3));
const mat = (b, c) => b.reduce((v, p) => p ? v + (p[0] === c ? 1 : -1) * VAL[p[1]] : v, 0);

/* El Guía: elige la jugada que mejor resiste la mejor réplica rival (profundidad 2). */
function aiPick(s) {
  let best = null, bs = -1e9;
  for (const m of legal(s)) {
    const n = ap(s, m), rep = legal(n); let sc;
    if (!rep.length) sc = inChk(n) ? 1e6 : 0;
    else { sc = 1e9; for (const r of rep) sc = Math.min(sc, mat(ap(n, r).b, s.turn)); }
    sc += Math.random() * 0.3;
    if (sc > bs) { bs = sc; best = m; }
  }
  return best;
}

function perft(s, d) { if (!d) return 1; let n = 0; for (const m of legal(s)) n += perft(ap(s, m), d - 1); return n; }
if (typeof module !== 'undefined') module.exports = { init, legal, ap, perft, inChk };

</script>
<script src="config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script>
/* MindChess · fx.js — sonido (Web Audio, sin archivos externos), voz (SpeechSynthesis) y efectos visuales. */
const FX = { snd: true, voz: true, ctx: null };
try { Object.assign(FX, JSON.parse(localStorage.getItem('mindchess_fx') || '{}')); } catch (e) {}
FX.save = () => { try { localStorage.setItem('mindchess_fx', JSON.stringify({ snd: FX.snd, voz: FX.voz })); } catch (e) {} };
const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

FX.unlock = () => {
  if (!FX.ctx && (window.AudioContext || window.webkitAudioContext)) FX.ctx = new (window.AudioContext || window.webkitAudioContext)();
  if (FX.ctx && FX.ctx.state === 'suspended') FX.ctx.resume();
  if (window.speechSynthesis) speechSynthesis.getVoices();
};

/* Nota con envolvente: frecuencia, duración, onda, volumen, retardo, glissando final. */
function tone(f, d, type = 'sine', v = .12, at = 0, to = null) {
  const c = FX.ctx; if (!c) return;
  const o = c.createOscillator(), g = c.createGain(), t = c.currentTime + at;
  o.type = type; o.frequency.setValueAtTime(f, t); if (to) o.frequency.exponentialRampToValueAtTime(to, t + d);
  g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(v, t + .01); g.gain.exponentialRampToValueAtTime(0.0001, t + d);
  o.connect(g).connect(c.destination); o.start(t); o.stop(t + d + .05);
}
function thud(d = .06, v = .15, at = 0) { /* ruido filtrado: golpe de madera */
  const c = FX.ctx; if (!c) return;
  const n = c.sampleRate * d, buf = c.createBuffer(1, n, c.sampleRate), a = buf.getChannelData(0);
  for (let i = 0; i < n; i++) a[i] = (Math.random() * 2 - 1) * (1 - i / n) ** 2;
  const s = c.createBufferSource(), fl = c.createBiquadFilter(), g = c.createGain();
  s.buffer = buf; fl.type = 'lowpass'; fl.frequency.value = 900; g.gain.value = v;
  s.connect(fl).connect(g).connect(c.destination); s.start(c.currentTime + at);
}
const ARP = (notes, step, type, v, d) => notes.forEach((f, i) => tone(f, d, type, v, i * step));

FX.play = k => {
  if (!FX.snd || !FX.ctx) return;
  ({
    start: () => ARP([392, 523, 659], .12, 'triangle', .1, .5),
    move: () => { thud(.07, .22); tone(180, .09, 'triangle', .06); },
    cap: () => { thud(.12, .35); tone(140, .18, 'sawtooth', .07, 0, 70); },
    castle: () => { thud(.07, .22); thud(.07, .22, .13); },
    promo: () => ARP([523, 659, 784, 1047], .08, 'triangle', .1, .35),
    check: () => { tone(880, .14, 'square', .06); tone(660, .22, 'square', .06, .15); },
    xp: () => { tone(988, .25, 'sine', .08); tone(1319, .4, 'sine', .08, .09); },
    draw: () => ARP([440, 392, 349], .18, 'sine', .1, .5),
    mate: () => { ARP([392, 494, 587, 784], .14, 'triangle', .12, 1.1); tone(196, 1.6, 'sine', .1, .1); tone(1175, 1.4, 'sine', .05, .6); }
  }[k] || (() => {}))();
};

FX.say = t => {
  if (!FX.voz || !window.speechSynthesis) return;
  speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(t); u.lang = 'es-ES'; u.rate = .95; u.pitch = .95;
  const v = speechSynthesis.getVoices().find(x => x.lang && x.lang.toLowerCase().startsWith('es')); if (v) u.voice = v;
  speechSynthesis.speak(u);
};

/* Lluvia de destellos dorados (el astro del logo). */
FX.burst = (n = 28) => {
  if (reduced()) return;
  const b = document.getElementById('board').getBoundingClientRect();
  for (let i = 0; i < n; i++) {
    const s = document.createElement('span'); s.className = 'star'; s.textContent = i % 3 ? '✦' : '✧';
    s.style.left = b.left + b.width / 2 + 'px'; s.style.top = b.top + b.height / 2 + 'px';
    const a = Math.random() * 6.283, r = 80 + Math.random() * 220;
    s.style.setProperty('--x', Math.cos(a) * r + 'px'); s.style.setProperty('--y', Math.sin(a) * r - 60 + 'px');
    s.style.fontSize = 10 + Math.random() * 20 + 'px'; document.body.append(s); setTimeout(() => s.remove(), 1700);
  }
};
FX.toast = t => {
  const e = document.createElement('div'); e.className = 'toast'; e.textContent = t; document.body.append(e); setTimeout(() => e.remove(), 1500);
};

</script>
<script>
/* MindChess · app.js — UI, capa reflexiva, guía CLI, comunidad, ranking y admin (persistencia local). */
const $ = s => document.querySelector(s);
const GL = { K: '♚', Q: '♛', R: '♜', B: '♝', N: '♞', P: '♟\uFE0E' };
const NM = { P: 'Peón', N: 'Caballo', B: 'Alfil', R: 'Torre', Q: 'Dama', K: 'Rey' };
const SKINS = [{ n: 'Sapientia', xp: 0, l: '#e4dccb', d: '#2f5b4d' }, { n: 'Niebla', xp: 30, l: '#f0f0f0', d: '#d4d4d4' }, { n: 'Grafito', xp: 50, l: '#e5e5e5', d: '#a3a3a3' }, { n: 'Tinta', xp: 150, l: '#d4d4d4', d: '#525252' }];
const QUOTES = ['Liderar es decidir con calma cuando el tablero pide prisa.', 'Una debilidad nombrada ya es una debilidad en movimiento.', 'La paciencia también es una jugada.', 'Cada pieza cumple su función; cada persona, también.', 'Ganar importa, pero cómo juegas importa más.', 'Una buena estrategia empieza por conocerse.'];
const BAD = ['idiota', 'estupido', 'imbecil', 'inutil', 'basura', 'tonto', 'payaso', 'mierda', 'perdedor', 'te odio', 'muerete', 'callate'];
const DEMO = [{ id: 'd1', n: 'Ada', elo: 1480, xp: 320, v: 1 }, { id: 'd2', n: 'Leo', elo: 1320, xp: 210 }, { id: 'd3', n: 'Mara', elo: 1210, xp: 410, v: 1 }, { id: 'd4', n: 'Iván', elo: 1105, xp: 90 }];

let S = { name: 'Jugador', elo: 1200, xp: 0, games: 0, sk: 0, ver: {}, wall: [], ref: { w: { s: {}, d: {} }, b: { s: {}, d: {} } } };
try { S = { ...S, ...JSON.parse(localStorage.getItem('mindchess') || '{}') }; } catch (e) {}
const save = () => { try { localStorage.setItem('mindchess', JSON.stringify(S)); } catch (e) {} };

let G, chan, role = null, sortBy = 'elo', side = 'w';
const el = (t, c, x) => { const e = document.createElement(t); if (c) e.className = c; if (x != null) e.textContent = x; return e; };

/* ---------- Guía CLI ---------- */
function log(pre, text, say) {
  const l = el('div', 'ln'); l.append(el('span', pre === '✓' ? 'ok' : 'pr', pre + ' '), document.createTextNode(text));
  const c = $('#cli'); c.append(l); c.scrollTop = c.scrollHeight; if (say) FX.say(say === true ? text : say);
}
function addXp(n, why) { S.xp += n; FX.play('xp'); FX.toast(`+${n} XP`); log('✓', `+${n} XP · ${why}`, !(G && G.over) && why.split(':')[0].split('(')[0]); save(); renderProfile(); }

/* ---------- Partida ---------- */
function newGame() {
  G = { s: init(), hist: [], keys: {}, over: false, sel: null, promo: null, mode: $('#mode').value, last: null };
  G.keys[key(G.s)] = 1; $('#cli').textContent = ''; $('#fair').hidden = true; FX.play('start');
  log('▲', 'guia --iniciar'); log('▲', G.mode === 'ai' ? 'Competitivo: juegas con Blancas contra El Guía (Elo 1200).' : 'Modo reflexivo: sin límite de tiempo.');
  log('▲', QUOTES[Math.floor(Math.random() * QUOTES.length)], true); render();
}
function render() {
  const s = G.s, b = $('#board'); b.textContent = '';
  const flip = role === 'b', lm = G.sel != null ? legal(s).filter(m => m.f === G.sel) : [];
  const order = [...Array(64).keys()]; if (flip) order.reverse();
  for (const i of order) {
    const p = s.b[i], q = el('button', 'sq ' + (((i >> 3) + (i & 7)) % 2 ? 'd' : 'l'));
    q.setAttribute('aria-label', sqName(i) + (p ? ' ' + NM[p[1]] + (p[0] === 'w' ? ' blanco' : ' negro') : ''));
    if (p) {
      const g = el('span', p[0], GL[p[1]]);
      if (G.anim && G.anim.t === i) { const k = flip ? -1 : 1; g.style.setProperty('--dx', ((G.anim.f & 7) - (i & 7)) * k * 100 + '%'); g.style.setProperty('--dy', ((G.anim.f >> 3) - (i >> 3)) * k * 100 + '%'); g.classList.add('slide'); q.classList.add('top'); }
      q.append(g);
      if (p[1] === 'K' && p[0] === s.turn && inChk(s)) q.classList.add('chk');
    }
    if (G.anim && G.anim.cap && G.anim.t === i) q.classList.add('boom');
    if (G.sel === i) q.classList.add('sel');
    if (G.last && (G.last.f === i || G.last.t === i)) q.classList.add('last');
    if (lm.some(m => m.t === i)) q.classList.add(p || (s.b[G.sel][1] === 'P' && i === s.ep) ? 'cp' : 'mv');
    q.onclick = () => click(i); b.append(q);
  }
  const ch = inChk(s), ms = legal(s);
  $('#status').textContent = G.over ? G.end : (ch ? 'Jaque · ' : '') + 'Turno de ' + (s.turn === 'w' ? 'Blancas' : 'Negras');
  const pr = $('#promo'); pr.textContent = '';
  if (G.promo) G.promo.forEach(m => { const x = el('button', 'btn g', GL[m.pr].replace('\uFE0E', '') + ' ' + NM[m.pr]); x.onclick = () => { G.promo = null; play(m); }; pr.append(x); });
  G.anim = null;
}
function click(i) {
  if (G.over || G.promo) return;
  const s = G.s; if (G.mode === 'ai' && s.turn === 'b') return; if (role && s.turn !== role) return;
  const opts = G.sel != null ? legal(s).filter(m => m.f === G.sel && m.t === i) : [];
  if (opts.length) { if (opts.length > 1) { G.promo = opts; render(); } else play(opts[0]); return; }
  G.sel = s.b[i] && s.b[i][0] === s.turn ? i : null; render();
}
function play(m, remote) {
  const s = G.s, col = s.turn, pc = s.b[m.f][1], n = ap(s, m), human = !remote && (G.mode !== 'ai' || col === 'w');
  G.hist.push({ f: m.f, t: m.t, pr: m.pr }); G.s = n; G.sel = null; G.last = m; G.anim = { f: m.f, t: m.t, cap: !!n.cap };
  log('▲', `${col === 'w' ? 'B' : 'N'} ${NM[pc]} ${sqName(m.f)}→${sqName(m.t)}` + (n.cap ? ` x${NM[n.cap[1]]}` : ''));
  if (human) {
    const R = S.ref[col], sx = R.s[pc], dx = n.cap && R.d[n.cap[1]];
    if (n.cap && sx) addXp(5, `Fortaleza aplicada (${NM[pc]}): ${sx}`);
    if (dx) addXp(8, `Debilidad superada (${NM[n.cap[1]]}): ${dx}`);
  }
  const k = key(n); G.keys[k] = (G.keys[k] || 0) + 1;
  const bal = mat(n.b, 'w'); if (G.hist.length % 4 === 0) log('▲', `Análisis: material ${bal === 0 ? 'igualado' : bal > 0 ? 'ventaja blanca +' + bal : 'ventaja negra +' + -bal}.`);
  if (G.hist.length % 8 === 0) log('▲', QUOTES[Math.floor(Math.random() * QUOTES.length)], true);
  const ms = legal(n), ch = inChk(n);
  if (!ms.length) finish(ch ? (col === 'w' ? 1 : 0) : .5, ch ? `Jaque mate · ganan ${col === 'w' ? 'Blancas' : 'Negras'}` : 'Tablas por ahogado');
  else if (G.keys[k] >= 3) finish(.5, 'Tablas por repetición (jaque perpetuo)');
  else if (ch) log('▲', 'Jaque.');
  FX.play(G.over ? (G.res === .5 ? 'draw' : 'mate') : ch ? 'check' : m.pr ? 'promo' : m.cs ? 'castle' : n.cap ? 'cap' : 'move');
  if (!G.over) FX.say(NM[pc] + (n.cap ? ' captura en ' : ' a ') + sqName(m.t) + (ch ? '. Jaque.' : ''));
  render();
  if (!remote && chan) chan.postMessage({ type: 'move', m: { f: m.f, t: m.t, pr: m.pr } });
  if (!G.over && G.mode === 'ai' && G.s.turn === 'b') setTimeout(() => play(aiPick(G.s)), 350);
}
function finish(res, text) {
  G.over = true; G.res = res; G.end = text; log('✓', text, true); if (res !== .5) FX.burst(); S.games++;
  if (G.mode === 'ai') { const e = Math.round(32 * (res - 1 / (1 + 10 ** ((1200 - S.elo) / 400)))); S.elo += e; log('✓', `Elo ${e >= 0 ? '+' : ''}${e} → ${S.elo}`); }
  addXp(res === 1 || res === 0 ? (G.mode === 'ai' && res === 0 ? 10 : 50) : 15, 'cierre de partida');
  $('#fair').hidden = false; save(); renderProfile(); pushGlobal();
}

/* ---------- Salas (demo en el mismo navegador; ver README para multijugador real) ---------- */
/* Canal de sala: P2P real con PeerJS (entre dispositivos) o BroadcastChannel (mismo navegador) como respaldo. */
function openChan(code, r, onmsg) {
  if (window.Peer) {
    const id = 'mindchess-' + code, q = []; let conn;
    const peer = new Peer(r === 'w' ? id : undefined);
    const bind = c => {
      conn = c; const go = () => { q.splice(0).forEach(m => c.send(m)); log('✓', 'Rival conectado'); };
      c.open ? go() : c.on('open', go); c.on('data', onmsg); c.on('close', () => log('▲', 'Rival desconectado'));
    };
    peer.on('connection', bind); peer.on('open', () => { if (r === 'b') bind(peer.connect(id)); });
    peer.on('error', er => log('▲', er.type === 'unavailable-id' ? 'Código en uso: crea otra sala.' : 'Conexión: ' + er.type));
    return { postMessage: m => (conn && conn.open) ? conn.send(m) : q.push(m), close: () => peer.destroy() };
  }
  const c = new BroadcastChannel('mindchess-' + code); c.onmessage = ev => onmsg(ev.data); return c;
}
function joinRoom(code, r) {
  role = r; if (chan) chan.close(); $('#mode').value = 'local';
  const onmsg = data => {
    if (data.type === 'hello' && role === 'w') chan.postMessage({ type: 'hist', list: G.hist });
    const apply = m => { const x = legal(G.s).find(v => v.f === m.f && v.t === m.t && v.pr === m.pr); if (x) play(x, true); };
    if (data.type === 'move') apply(data.m);
    if (data.type === 'hist' && role === 'b' && !G.hist.length) data.list.forEach(apply);
  };
  chan = openChan(code, r, onmsg);
  newGame(); log('▲', `Sala ${code}: juegas con ${r === 'w' ? 'Blancas' : 'Negras'}.`, `Sala ${code}`); if (r === 'b') chan.postMessage({ type: 'hello' });
}
$('#room').onclick = () => {
  const code = Math.random().toString(36).slice(2, 8).toUpperCase(); location.hash = 'sala=' + code; joinRoom(code, 'w');
  const url = location.href; if (navigator.share) navigator.share({ title: 'MindChess', text: 'Juega conmigo en MindChess', url }).catch(() => {});
  (navigator.clipboard ? navigator.clipboard.writeText(url) : Promise.reject()).then(() => log('✓', 'Enlace copiado'), () => log('▲', url));
  log('▲', 'Envía el enlace a tu rival: jugará con Negras.');
};

/* ---------- Reflexión previa ---------- */
function renderRef() {
  const f = $('#refrows'); f.textContent = ''; $('#sideName').textContent = side === 'w' ? 'Blancas' : 'Negras';
  for (const t of Object.keys(NM)) {
    const row = el('div', 'rrow'), a = el('input'), d = el('input');
    a.placeholder = `Fortaleza de mi ${NM[t]}`; d.placeholder = `Debilidad a superar (${NM[t]} rival)`;
    a.value = S.ref[side].s[t] || ''; d.value = S.ref[side].d[t] || '';
    a.oninput = () => S.ref[side].s[t] = a.value.trim(); d.oninput = () => S.ref[side].d[t] = d.value.trim();
    a.maxLength = d.maxLength = 60; row.append(el('b', '', GL[t].replace('\uFE0E', '') + ' ' + NM[t]), a, d); f.append(row);
  }
}
$('#refbtn').onclick = () => { renderRef(); $('#refdlg').showModal(); };
$('#swap').onclick = () => { side = side === 'w' ? 'b' : 'w'; renderRef(); };
$('#refok').onclick = () => { save(); log('✓', 'Propósitos guardados'); };

/* ---------- Perfil, ranking, comunidad, admin ---------- */
const title = () => S.xp >= 300 ? 'Maestro de la Reflexión' : S.xp >= 100 ? 'Estratega Consciente' : 'Aprendiz';
const badge = id => S.ver[id] ? el('span', 'badge', 'VERIFICADO ▲') : document.createTextNode('');
function renderProfile() {
  $('#pname').value = S.name; $('#pelo').textContent = S.elo; $('#pxp').textContent = S.xp; $('#ptitle').textContent = title();
  $('#pgames').textContent = S.games; $('#pbadge').textContent = ''; $('#pbadge').append(badge('me'));
  const sk = $('#skin'); sk.textContent = '';
  SKINS.forEach((k, i) => { const o = el('option', '', k.n + (S.xp < k.xp ? ` (${k.xp} XP)` : '')); o.value = i; o.disabled = S.xp < k.xp; sk.append(o); });
  sk.value = S.sk; const k = SKINS[S.sk] || SKINS[0]; document.documentElement.style.setProperty('--l', k.l); document.documentElement.style.setProperty('--d', k.d);
  renderRank(); renderAdmin();
}
const all = () => GLOBAL || [{ id: 'me', n: S.name, elo: S.elo, xp: S.xp }, ...DEMO].map(p => ({ ...p, v: S.ver[p.id] ?? p.v }));
function renderRank() {
  const t = $('#rank'); t.textContent = ''; const h = el('tr'); ['#', 'Jugador', 'Elo táctico', 'XP'].forEach(x => h.append(el('th', '', x))); t.append(h);
  all().sort((a, b) => b[sortBy] - a[sortBy]).forEach((p, i) => {
    const r = el('tr'); r.append(el('td', '', i + 1)); const c = el('td', '', p.n + ' '); c.append(p.v ? el('span', 'badge', 'VERIFICADO ▲') : ''); r.append(c, el('td', '', p.elo), el('td', '', p.xp)); t.append(r);
  });
}
function renderAdmin() {
  const a = $('#adminlist'); a.textContent = '';
  all().forEach(p => { const r = el('div', 'arow', p.n + (p.id === 'me' ? ' (tú)' : '')), b = el('button', 'btn g', p.v ? 'Retirar insignia' : 'Asignar insignia'); b.onclick = () => { S.ver[p.id] = p.v ? 0 : 1; save(); renderProfile(); renderWall(); }; r.append(b); a.append(r); });
}
function renderWall() {
  const w = $('#walllist'); w.textContent = '';
  [...S.wall, { n: 'Ada', k: 'Reflexión', x: 'Mi Caballo es la paciencia: hoy esperé tres jugadas antes de atacar.', id: 'd1' }].forEach(p => {
    const c = el('div', 'card post'), h = el('div', 'mono', `${p.k} · ${p.n} `); h.append(badge(p.id || 'me')); c.append(h, el('p', '', p.x)); w.append(c);
  });
}
$('#post').onclick = () => {
  const x = $('#ptext').value.trim(), norm = x.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  if (!x) return; if (BAD.some(b => norm.includes(b))) { $('#wmsg').textContent = 'No publicado: el filtro detectó lenguaje ofensivo. Reformula con respeto.'; return; }
  S.wall.unshift({ n: S.name, k: $('#kind').value, x, id: 'me' }); $('#ptext').value = ''; $('#wmsg').textContent = 'Publicado.'; save(); renderWall();
};
$('#pname').onchange = e => { S.name = e.target.value.trim().slice(0, 24) || 'Jugador'; save(); renderProfile(); };
$('#skin').onchange = e => { S.sk = +e.target.value; save(); renderProfile(); };
$('#fair').onclick = () => { $('#fair').hidden = true; addXp(10, 'Fair Play: reconociste al rival'); };
$('#new').onclick = newGame; $('#mode').onchange = () => { role = null; if (chan) chan.close(), chan = null; newGame(); };
document.querySelectorAll('[data-sort]').forEach(b => b.onclick = () => { sortBy = b.dataset.sort; renderRank(); });
document.querySelectorAll('[data-tab]').forEach(b => b.onclick = () => {
  document.querySelectorAll('[data-tab]').forEach(x => x.setAttribute('aria-selected', x === b));
  document.querySelectorAll('.view').forEach(v => v.hidden = v.id !== 'v-' + b.dataset.tab);
});

const refreshFx = () => { $('#fxsnd').textContent = 'Sonido: ' + (FX.snd ? 'sí' : 'no'); $('#fxvoz').textContent = 'Voz: ' + (FX.voz ? 'sí' : 'no'); };
$('#fxsnd').onclick = () => { FX.unlock(); FX.snd = !FX.snd; FX.save(); refreshFx(); FX.play('xp'); };
$('#fxvoz').onclick = () => { FX.unlock(); FX.voz = !FX.voz; FX.save(); refreshFx(); if (FX.voz) FX.say('Voz activada'); else speechSynthesis.cancel(); };
$('#enter').onclick = () => { FX.unlock(); $('#splash').classList.add('out'); FX.play('start'); FX.say('Bienvenido a MindChess. Proyecto Sapientia.'); setTimeout(() => $('#splash').remove(), 700); };
document.addEventListener('pointerdown', FX.unlock, { once: true });
refreshFx(); renderProfile(); renderWall(); newGame();
const m = location.hash.match(/^#sala=(\w+)/); if (m) joinRoom(m[1], 'b');

/* ---------- Ranking global opcional (Supabase) ---------- */
const CFG = window.MC_CFG || {}; let GLOBAL = null;
const sb = (p, o = {}) => fetch(CFG.url + '/rest/v1/' + p, { ...o, headers: { apikey: CFG.key, Authorization: 'Bearer ' + CFG.key, 'Content-Type': 'application/json', Prefer: 'resolution=merge-duplicates', ...(o.headers || {}) } });
async function loadGlobal() {
  if (!CFG.url) return;
  try { const r = await sb('perfiles?select=id,nombre,elo,xp,verificado&order=elo.desc&limit=50'); GLOBAL = (await r.json()).map(p => ({ id: p.id, n: p.nombre, elo: p.elo, xp: p.xp, v: p.verificado })); renderRank(); } catch (e) {}
}
async function pushGlobal() {
  if (!CFG.url) return; S.uid = S.uid || crypto.randomUUID(); save();
  try { await sb('perfiles', { method: 'POST', body: JSON.stringify({ id: S.uid, nombre: S.name, elo: S.elo, xp: S.xp }) }); loadGlobal(); } catch (e) {}
}
/* ---------- Instalación (PWA) ---------- */
let dip; addEventListener('beforeinstallprompt', e => { e.preventDefault(); dip = e; $('#install').hidden = false; });
$('#install').onclick = () => { if (dip) { dip.prompt(); dip = null; $('#install').hidden = true; } };
if ('serviceWorker' in navigator && /^https?:$/.test(location.protocol)) navigator.serviceWorker.register('sw.js').catch(() => {});
loadGlobal();

</script>
