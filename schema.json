{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MindChess",
  "$defs": {
    "color": { "enum": ["w", "b"] },
    "propositos": {
      "type": "object",
      "description": "Reflexión previa por tipo de pieza (P,N,B,R,Q,K).",
      "properties": {
        "fortalezas": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 60 } },
        "debilidades_rival": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 60 } }
      }
    },
    "usuario": {
      "type": "object",
      "required": ["id", "nombre", "elo", "xp"],
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string", "maxLength": 24 },
        "elo": { "type": "integer", "minimum": 0 },
        "xp": { "type": "integer", "minimum": 0 },
        "titulo": { "type": "string" },
        "medallas": { "type": "array", "items": { "type": "string" } },
        "skin": { "type": "string" },
        "verificado": { "$ref": "#/$defs/insignia" }
      }
    },
    "insignia": {
      "type": "object",
      "required": ["activa"],
      "properties": {
        "activa": { "type": "boolean" },
        "etiqueta": { "const": "VERIFICADO ▲" },
        "asignada_por": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" }
      }
    },
    "xp_evento": {
      "type": "object",
      "required": ["usuario_id", "puntos", "motivo"],
      "properties": {
        "usuario_id": { "type": "string" },
        "partida_id": { "type": "string" },
        "puntos": { "type": "integer" },
        "motivo": { "enum": ["fortaleza_aplicada", "debilidad_superada", "cierre_partida", "fair_play"] },
        "fecha": { "type": "string", "format": "date-time" }
      }
    },
    "partida": {
      "type": "object",
      "required": ["id", "modo", "jugadores", "tablero", "turno", "estado"],
      "properties": {
        "id": { "type": "string" },
        "modo": { "enum": ["competitivo", "reflexivo"] },
        "sala": { "type": "string", "pattern": "^[A-Z0-9]{6}$" },
        "jugadores": { "type": "object", "properties": { "w": { "type": "string" }, "b": { "type": "string" } } },
        "propositos": { "type": "object", "properties": { "w": { "$ref": "#/$defs/propositos" }, "b": { "$ref": "#/$defs/propositos" } } },
        "tablero": { "type": "array", "minItems": 64, "maxItems": 64, "items": { "type": ["string", "null"], "pattern": "^[wb][PNBRQK]$" } },
        "turno": { "$ref": "#/$defs/color" },
        "enroque": { "type": "object", "properties": { "wK": { "type": "boolean" }, "wQ": { "type": "boolean" }, "bK": { "type": "boolean" }, "bQ": { "type": "boolean" } } },
        "al_paso": { "type": "integer", "minimum": -1, "maximum": 63 },
        "jugadas": { "type": "array", "items": { "type": "object", "properties": { "f": { "type": "integer" }, "t": { "type": "integer" }, "pr": { "enum": ["Q", "R", "B", "N"] } } } },
        "estado": { "enum": ["en_curso", "jaque_mate", "ahogado", "repeticion"] },
        "ganador": { "enum": ["w", "b", null] }
      }
    }
  }
}
